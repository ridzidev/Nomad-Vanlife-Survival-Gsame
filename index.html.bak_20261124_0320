<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nomad Vanlife — 3D Camper Van Survival</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <link rel="stylesheet" href="css/style.css" />
</head>
<body>
  <canvas id="game-canvas"></canvas>

  <!-- HUD -->
  <div id="hud">
    <div class="hud-row">
      <!-- Survival Stats -->
      <div class="panel">
        <div class="stats-grid">
          <div class="stat-item">
            <div class="stat-label"><span>❤️ Kesehatan</span><span id="txt-hp">100%</span></div>
            <div class="bar-track"><div id="bar-hp" class="bar-fill" style="background:#ef4444"></div></div>
          </div>
          <div class="stat-item">
            <div class="stat-label"><span>🍖 Lapar</span><span id="txt-hunger">100%</span></div>
            <div class="bar-track"><div id="bar-hunger" class="bar-fill" style="background:#f59e0b"></div></div>
          </div>
          <div class="stat-item">
            <div class="stat-label"><span>💧 Haus</span><span id="txt-thirst">100%</span></div>
            <div class="bar-track"><div id="bar-thirst" class="bar-fill" style="background:#38bdf8"></div></div>
          </div>
          <div class="stat-item">
            <div class="stat-label"><span>⚡ Stamina</span><span id="txt-stamina">100%</span></div>
            <div class="bar-track"><div id="bar-stamina" class="bar-fill" style="background:#a3e635"></div></div>
          </div>
        </div>
      </div>

      <!-- Biome & Time -->
      <div class="panel world-badge">
        <div id="biome-pill" class="biome-pill">🌲 Hutan</div>
        <div class="time-row">
          <span id="txt-day">Hari 1</span>
          <span>•</span>
          <span id="txt-clock">08:00</span>
          <span>•</span>
          <span id="txt-temp">26°C</span>
        </div>
        <div style="font-size:11px; color:var(--muted)" id="txt-coords">X: 0 | Z: 0 • Jarak: 0 m</div>
      </div>

      <!-- Quick Menu -->
      <div class="panel quick-actions">
        <button class="btn primary" onclick="openInventoryModal()" title="Tab / I">🧊 Tas & Kulkas</button>
        <button class="btn" onclick="openCustomizeModal()" title="B">🎨 Hias Mobil</button>
        <button class="btn" onclick="openMapModal()" title="M">🗺️ Peta</button>
        <button class="btn" onclick="sleepInVan()" title="Tidur di Camper">⛺ Tidur</button>
        <button class="btn" id="btn-audio" onclick="toggleAudio()">🔊 Audio</button>
        <button class="btn" onclick="manualSave()">💾 Simpan</button>
        <button class="btn danger" onclick="confirmResetWorld()">🔄 Baru</button>
      </div>
    </div>

    <!-- Bottom HUD -->
    <div class="hud-row bottom-hud">
      <!-- Vehicle Dash -->
      <div class="panel vehicle-dash">
        <button class="btn primary" id="btn-toggle-van" onclick="toggleVehicleMode()" style="min-height:42px;">🚶 Turun Mobil [E]</button>
        <div class="speedo">
          <div class="speedo-val" id="txt-speed">0</div>
          <div class="speedo-unit" id="txt-mode">KM/J • MOBIL</div>
        </div>
        <div class="stats-grid" style="grid-template-columns: repeat(3, 105px);">
          <div class="stat-item">
            <div class="stat-label"><span>⛽ Bensin</span><span id="txt-fuel">100%</span></div>
            <div class="bar-track"><div id="bar-fuel" class="bar-fill" style="background:#fb923c"></div></div>
          </div>
          <div class="stat-item">
            <div class="stat-label"><span>🔋 Baterai</span><span id="txt-bat">100%</span></div>
            <div class="bar-track"><div id="bar-bat" class="bar-fill" style="background:#22d3ee"></div></div>
          </div>
          <div class="stat-item">
            <div class="stat-label"><span>🔧 Kondisi</span><span id="txt-van-hp">100%</span></div>
            <div class="bar-track"><div id="bar-van-hp" class="bar-fill" style="background:#4ade80"></div></div>
          </div>
        </div>
      </div>

      <!-- Controls -->
      <div class="panel controls-hint" id="controls-hint">
        <div><kbd>W A S D</kbd> Stir / Jalan • <kbd>Space</kbd> Rem / Lompat • <kbd>Shift</kbd> Lari</div>
        <div><kbd>E</kbd> Keluar / Masuk Mobil • <kbd>F</kbd> Ambil / Isi / Pom Bensin</div>
        <div><kbd>L</kbd> Lampu • <kbd>H</kbd> Klakson • <kbd>C</kbd> Kamera • <kbd>Mouse Drag</kbd> Putar</div>
      </div>
    </div>
  </div>

  <!-- Interact Prompt -->
  <div id="interact-prompt" onclick="triggerInteract()">[F] Interaksi</div>

  <!-- Toast -->
  <div id="toast-container"></div>

  <!-- Mobile Touch Controls -->
  <div id="mobile-controls">
    <div class="touch-pad">
      <div></div><button class="touch-btn" onpointerdown="touchKey('KeyW',1)" onpointerup="touchKey('KeyW',0)" onpointerleave="touchKey('KeyW',0)">▲</button><div></div>
      <button class="touch-btn" onpointerdown="touchKey('KeyA',1)" onpointerup="touchKey('KeyA',0)" onpointerleave="touchKey('KeyA',0)">◀</button>
      <button class="touch-btn" onpointerdown="touchKey('KeyS',1)" onpointerup="touchKey('KeyS',0)" onpointerleave="touchKey('KeyS',0)">▼</button>
      <button class="touch-btn" onpointerdown="touchKey('KeyD',1)" onpointerup="touchKey('KeyD',0)" onpointerleave="touchKey('KeyD',0)">▶</button>
    </div>
    <div style="display:flex; flex-direction:column; gap:8px; pointer-events:auto;">
      <button class="btn primary" onclick="toggleVehicleMode()">🚗 Masuk/Keluar</button>
      <button class="btn success" onclick="triggerInteract()">✋ Interaksi</button>
    </div>
  </div>

  <!-- Modal: Inventory, Fridge & Stove -->
  <div class="modal-backdrop" id="modal-inventory">
    <div class="modal-box">
      <div class="modal-header">
        <h2>🎒 Tas Ransel, 🧊 Kulkas Mobil & 🍳 Kompor Camper</h2>
        <button class="btn" onclick="closeAllModals()">✖ Tutup (Esc)</button>
      </div>
      <div class="modal-body">
        <div class="inv-layout">
          <!-- Backpack -->
          <div class="col-box">
            <div class="col-title">
              <span>🎒 Tas Ransel</span>
              <span id="inv-count" style="font-size:12px; color:var(--muted)">0 / 20</span>
            </div>
            <div class="item-list" id="backpack-list"></div>
          </div>

          <!-- Fridge -->
          <div class="col-box">
            <div class="col-title">
              <span>🧊 Kulkas Mobil</span>
              <div style="display:flex; gap:6px; align-items:center;">
                <span id="fridge-temp-badge" style="font-size:11px; color:var(--info)">4°C ❄️</span>
                <button class="btn btn-xs" id="btn-fridge-toggle" onclick="toggleFridgePower()">ON</button>
              </div>
            </div>
            <div style="display:flex; justify-content:space-between; font-size:11px; color:var(--muted);">
              <span id="fridge-slots">Slot: 0 / 8</span>
              <span>Pendingin awetkan makanan 6x</span>
            </div>
            <div class="item-list" id="fridge-list"></div>
          </div>

          <!-- Stove & Crafting -->
          <div class="col-box">
            <div class="col-title">
              <span>🍳 Kompor & Bengkel Mini</span>
              <span style="font-size:11px; color:var(--accent)">Masak & Rakit</span>
            </div>
            <div class="item-list" id="recipe-list"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: Customize Van -->
  <div class="modal-backdrop" id="modal-customize">
    <div class="modal-box">
      <div class="modal-header">
        <h2>🎨 Hias & Upgrade Camper Van</h2>
        <button class="btn" onclick="closeAllModals()">✖ Selesai</button>
      </div>
      <div class="modal-body">
        <div style="font-size:12px; color:var(--muted); margin-bottom:8px;">
          Geser layar di sebelah kiri untuk memutar kamera melihat camper van-mu!
        </div>

        <div class="section-label">Warna Utama Bodi</div>
        <div class="color-row" id="primary-colors"></div>

        <div class="section-label">Warna Atap / Aksen</div>
        <div class="color-row" id="accent-colors"></div>

        <div class="section-label">Corak / Stiker Mobil</div>
        <div class="color-row" id="livery-buttons"></div>

        <div class="section-label">Aksesori & Dekorasi Camper</div>
        <div class="decor-grid" id="decor-list"></div>

        <div class="section-label">Upgrade Sistem Mobil</div>
        <div class="decor-grid" id="upgrade-list"></div>
      </div>
    </div>
  </div>

  <!-- Modal: Map -->
  <div class="modal-backdrop" id="modal-map">
    <div class="modal-box" style="width:min(560px, 95vw)">
      <div class="modal-header">
        <h2>🗺️ Peta Bioma Sekitar</h2>
        <button class="btn" onclick="closeAllModals()">✖ Tutup</button>
      </div>
      <div class="modal-body" style="text-align:center;">
        <canvas id="map-canvas" width="320" height="320"></canvas>
        <div class="map-legend">
          <span><span class="legend-dot" style="background:#3d4148"></span>Jalan Raya</span>
          <span><span class="legend-dot" style="background:#3c8d40"></span>Hutan</span>
          <span><span class="legend-dot" style="background:#e4be6d"></span>Gurun</span>
          <span><span class="legend-dot" style="background:#f1d99a"></span>Pantai</span>
          <span><span class="legend-dot" style="background:#8b95a5"></span>Gunung</span>
          <span><span class="legend-dot" style="background:#a16207"></span>Desa</span>
          <span><span class="legend-dot" style="background:#64748b"></span>Kota / Pom</span>
          <span><span class="legend-dot" style="background:#ef4444; border-radius:50%"></span>Kamu & Van</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Game Over -->
  <div id="gameover-screen">
    <h1 style="font-size:36px; margin:0; color:#ef4444;">💀 Perjalanan Berakhir</h1>
    <p id="gameover-reason" style="color:#cbd5e1; max-width:420px;">Kamu kehabisan tenaga di alam liar.</p>
    <p id="gameover-stats" style="color:#fbbf24; font-weight:600;"></p>
    <div style="display:flex; gap:10px;">
      <button class="btn primary" onclick="respawnAtVan()">🚑 Bangkit di Camper Van (Pertahankan Mobil)</button>
      <button class="btn danger" onclick="resetWorldNow()">🔄 Mulai Dunia Baru</button>
    </div>
  </div>

    <script src="js/data.js"></script>
  <script src="js/audio.js"></script>
  <script src="js/state.js"></script>
  <script src="js/scene.js"></script>
  <script src="js/world.js"></script>
  <script src="js/van.js"></script>
  <script src="js/player.js"></script>
  <script src="js/ui.js"></script>
  <script src="js/main.js"></script>
</body>
</html>