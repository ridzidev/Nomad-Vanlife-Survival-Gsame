<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nomad Vanlife — 3D Camper Van Survival</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <style>
    :root {
      --bg-glass: rgba(15, 22, 32, 0.78);
      --bg-card: rgba(25, 35, 50, 0.9);
      --border: rgba(255, 255, 255, 0.14);
      --accent: #f59e0b;
      --accent-2: #10b981;
      --danger: #ef4444;
      --info: #38bdf8;
      --text: #f8fafc;
      --muted: #94a3b8;
    }

    * { box-sizing: border-box; user-select: none; }
    html, body {
      margin: 0; padding: 0; width: 100%; height: 100%;
      overflow: hidden; background: #0b1120;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      color: var(--text);
    }

    #game-canvas {
      display: block; width: 100%; height: 100%;
      cursor: grab;
    }
    #game-canvas:active { cursor: grabbing; }

    /* HUD */
    #hud {
      position: fixed; inset: 0; pointer-events: none;
      display: flex; flex-direction: column; justify-content: space-between;
      padding: 14px; z-index: 10;
    }

    .hud-row {
      display: flex; justify-content: space-between; align-items: flex-start; gap: 12px;
    }

    .panel {
      background: var(--bg-glass);
      backdrop-filter: blur(10px);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 10px 14px;
      pointer-events: auto;
      box-shadow: 0 8px 28px rgba(0,0,0,0.35);
    }

    /* Bars */
    .stats-grid {
      display: grid; grid-template-columns: repeat(2, 145px); gap: 8px 12px;
    }
    .stat-item { display: flex; flex-direction: column; gap: 3px; }
    .stat-label {
      display: flex; justify-content: space-between; font-size: 11px; font-weight: 600; color: #e2e8f0;
    }
    .bar-track {
      width: 100%; height: 7px; background: rgba(255,255,255,0.12);
      border-radius: 99px; overflow: hidden;
    }
    .bar-fill {
      height: 100%; width: 100%; border-radius: 99px; transition: width 0.2s ease;
    }

    /* World Info */
    .world-badge {
      display: flex; flex-direction: column; align-items: center; text-align: center; gap: 4px;
      min-width: 210px;
    }
    .biome-pill {
      font-size: 13px; font-weight: 700; letter-spacing: 0.4px;
      padding: 3px 10px; border-radius: 99px; background: rgba(255,255,255,0.1);
    }
    .time-row { font-size: 12px; color: var(--muted); display: flex; gap: 10px; align-items: center; }

    /* Top Right Buttons */
    .quick-actions { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; max-width: 340px; }
    .btn {
      background: rgba(255,255,255,0.1); color: var(--text);
      border: 1px solid var(--border); border-radius: 10px;
      padding: 7px 11px; font-size: 12px; font-weight: 600;
      cursor: pointer; transition: 0.15s; display: inline-flex; align-items: center; gap: 5px;
    }
    .btn:hover { background: rgba(255,255,255,0.2); transform: translateY(-1px); }
    .btn.primary { background: var(--accent); color: #111827; border-color: #fbbf24; }
    .btn.primary:hover { background: #fbbf24; }
    .btn.success { background: var(--accent-2); color: #052e16; border-color: #34d399; }
    .btn.danger { background: rgba(239,68,68,0.25); border-color: rgba(239,68,68,0.5); color: #fecaca; }
    .btn:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }

    /* Bottom HUD */
    .bottom-hud { align-items: flex-end; }
    .vehicle-dash { display: flex; gap: 16px; align-items: center; }
    .speedo {
      text-align: center; min-width: 72px; padding-right: 12px;
      border-right: 1px solid var(--border);
    }
    .speedo-val { font-size: 26px; font-weight: 800; line-height: 1; color: var(--accent); }
    .speedo-unit { font-size: 10px; color: var(--muted); text-transform: uppercase; }

    .controls-hint {
      font-size: 11px; color: #cbd5e1; line-height: 1.5; max-width: 310px;
    }
    kbd {
      background: rgba(255,255,255,0.16); padding: 1px 5px; border-radius: 4px;
      font-family: monospace; font-size: 10px; border: 1px solid rgba(255,255,255,0.2);
    }

    /* Prompt */
    #interact-prompt {
      position: fixed; bottom: 115px; left: 50%; transform: translateX(-50%);
      background: rgba(15, 23, 42, 0.9); border: 1px solid var(--accent);
      color: #fef3c7; padding: 8px 16px; border-radius: 99px;
      font-size: 13px; font-weight: 600; pointer-events: auto; cursor: pointer;
      display: none; z-index: 15; box-shadow: 0 4px 20px rgba(245, 158, 11, 0.25);
      animation: pulsePrompt 1.5s infinite;
    }
    @keyframes pulsePrompt {
      0%, 100% { transform: translateX(-50%) scale(1); }
      50% { transform: translateX(-50%) scale(1.03); }
    }

    /* Toast Notifications */
    #toast-container {
      position: fixed; top: 88px; left: 50%; transform: translateX(-50%);
      display: flex; flex-direction: column; gap: 6px; z-index: 40; pointer-events: none;
    }
    .toast {
      background: rgba(15, 23, 42, 0.92); border: 1px solid var(--border);
      padding: 8px 14px; border-radius: 10px; font-size: 13px; font-weight: 500;
      box-shadow: 0 6px 20px rgba(0,0,0,0.4); animation: fadeSlide 0.25s ease;
    }
    @keyframes fadeSlide {
      from { opacity: 0; transform: translateY(-8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Modals */
    .modal-backdrop {
      position: fixed; inset: 0; background: rgba(5, 8, 15, 0.65);
      backdrop-filter: blur(5px); display: none; justify-content: center; align-items: center;
      z-index: 30; padding: 16px;
    }
    .modal-backdrop.open { display: flex; }

    /* Customize side drawer so user can still see the 3D van! */
    #modal-customize {
      background: transparent; backdrop-filter: none; justify-content: flex-end; pointer-events: none;
    }
    #modal-customize .modal-box {
      pointer-events: auto; width: 390px; max-height: 90vh;
    }

    .modal-box {
      background: #111827; border: 1px solid rgba(255,255,255,0.16);
      border-radius: 18px; width: min(1040px, 96vw); max-height: 88vh;
      display: flex; flex-direction: column; overflow: hidden;
      box-shadow: 0 20px 60px rgba(0,0,0,0.6);
    }
    .modal-header {
      padding: 14px 18px; border-bottom: 1px solid var(--border);
      display: flex; justify-content: space-between; align-items: center;
      background: rgba(255,255,255,0.03);
    }
    .modal-header h2 { margin: 0; font-size: 17px; display: flex; align-items: center; gap: 8px; }
    .modal-body { padding: 16px; overflow-y: auto; flex: 1; }

    /* Inventory + Fridge 3-col layout */
    .inv-layout {
      display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px;
    }
    @media (max-width: 860px) { .inv-layout { grid-template-columns: 1fr; } }

    .col-box {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 14px; padding: 12px; display: flex; flex-direction: column; gap: 10px;
    }
    .col-title {
      display: flex; justify-content: space-between; align-items: center;
      font-size: 14px; font-weight: 700; padding-bottom: 8px; border-bottom: 1px solid var(--border);
    }

    .item-list { display: flex; flex-direction: column; gap: 7px; max-height: 410px; overflow-y: auto; }
    .item-card {
      background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px; padding: 8px 10px; display: flex; flex-direction: column; gap: 5px;
    }
    .item-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
    .item-name { font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 6px; }
    .item-desc { font-size: 11px; color: var(--muted); }
    .item-actions { display: flex; gap: 5px; flex-wrap: wrap; }
    .btn-xs { padding: 4px 8px; font-size: 11px; border-radius: 7px; }

    .fresh-bar { width: 100%; height: 4px; background: rgba(255,255,255,0.1); border-radius: 4px; overflow: hidden; }
    .fresh-fill { height: 100%; background: #22c55e; }

    /* Customize Controls */
    .color-row { display: flex; gap: 7px; flex-wrap: wrap; margin-top: 6px; }
    .swatch {
      width: 28px; height: 28px; border-radius: 50%; border: 2px solid transparent;
      cursor: pointer; transition: transform 0.12s;
    }
    .swatch.active { border-color: #fff; transform: scale(1.14); }
    .section-label { font-size: 12px; font-weight: 700; color: #cbd5e1; margin-top: 12px; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }

    .decor-grid { display: flex; flex-direction: column; gap: 8px; }
    .decor-card {
      background: rgba(255,255,255,0.05); border: 1px solid var(--border);
      border-radius: 10px; padding: 9px 11px; display: flex; justify-content: space-between; align-items: center; gap: 10px;
    }

    /* Map Canvas */
    #map-canvas {
      width: 100%; max-width: 460px; aspect-ratio: 1; border-radius: 12px;
      border: 1px solid var(--border); display: block; margin: 0 auto; background: #0f172a;
    }
    .map-legend {
      display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 12px; font-size: 12px;
    }
    .legend-dot { width: 12px; height: 12px; border-radius: 3px; display: inline-block; vertical-align: middle; margin-right: 4px; }

    /* Game Over Overlay */
    #gameover-screen {
      position: fixed; inset: 0; background: rgba(10, 10, 18, 0.88);
      display: none; flex-direction: column; justify-content: center; align-items: center;
      z-index: 50; text-align: center; gap: 14px; padding: 20px;
    }
    #gameover-screen.open { display: flex; }

    /* Touch Controls for Mobile / Optional Mouse */
    #mobile-controls {
      display: none; position: fixed; bottom: 100px; left: 16px; right: 16px;
      justify-content: space-between; pointer-events: none; z-index: 12;
    }
    @media (hover: none) and (pointer: coarse) {
      #mobile-controls { display: flex; }
      .controls-hint { display: none; }
    }
    .touch-pad { display: grid; grid-template-columns: repeat(3, 48px); gap: 6px; pointer-events: auto; }
    .touch-btn {
      width: 48px; height: 48px; border-radius: 12px; background: rgba(15,23,42,0.75);
      border: 1px solid var(--border); color: #fff; font-size: 18px; font-weight: bold;
    }
  </style>
</head>
<body>
  <canvas id="game-canvas"></canvas>

  <!-- HUD -->
  <div id="hud">
    <div class="hud-row">
      <!-- Survival Stats -->
      <div class="panel">
        <div class="stats-grid">
          <div class="stat-item">
            <div class="stat-label"><span>❤️ Kesehatan</span><span id="txt-hp">100%</span></div>
            <div class="bar-track"><div id="bar-hp" class="bar-fill" style="background:#ef4444"></div></div>
          </div>
          <div class="stat-item">
            <div class="stat-label"><span>🍖 Lapar</span><span id="txt-hunger">100%</span></div>
            <div class="bar-track"><div id="bar-hunger" class="bar-fill" style="background:#f59e0b"></div></div>
          </div>
          <div class="stat-item">
            <div class="stat-label"><span>💧 Haus</span><span id="txt-thirst">100%</span></div>
            <div class="bar-track"><div id="bar-thirst" class="bar-fill" style="background:#38bdf8"></div></div>
          </div>
          <div class="stat-item">
            <div class="stat-label"><span>⚡ Stamina</span><span id="txt-stamina">100%</span></div>
            <div class="bar-track"><div id="bar-stamina" class="bar-fill" style="background:#a3e635"></div></div>
          </div>
        </div>
      </div>

      <!-- Biome & Time -->
      <div class="panel world-badge">
        <div id="biome-pill" class="biome-pill">🌲 Hutan</div>
        <div class="time-row">
          <span id="txt-day">Hari 1</span>
          <span>•</span>
          <span id="txt-clock">08:00</span>
          <span>•</span>
          <span id="txt-temp">26°C</span>
        </div>
        <div style="font-size:11px; color:var(--muted)" id="txt-coords">X: 0 | Z: 0 • Jarak: 0 m</div>
      </div>

      <!-- Quick Menu -->
      <div class="panel quick-actions">
        <button class="btn primary" onclick="openInventoryModal()" title="Tab / I">🧊 Tas & Kulkas</button>
        <button class="btn" onclick="openCustomizeModal()" title="B">🎨 Hias Mobil</button>
        <button class="btn" onclick="openMapModal()" title="M">🗺️ Peta</button>
        <button class="btn" onclick="sleepInVan()" title="Tidur di Camper">⛺ Tidur</button>
        <button class="btn" id="btn-audio" onclick="toggleAudio()">🔊 Audio</button>
        <button class="btn" onclick="manualSave()">💾 Simpan</button>
        <button class="btn danger" onclick="confirmResetWorld()">🔄 Baru</button>
      </div>
    </div>

    <!-- Bottom HUD -->
    <div class="hud-row bottom-hud">
      <!-- Vehicle Dash -->
      <div class="panel vehicle-dash">
        <div class="speedo">
          <div class="speedo-val" id="txt-speed">0</div>
          <div class="speedo-unit" id="txt-mode">KM/J • MOBIL</div>
        </div>
        <div class="stats-grid" style="grid-template-columns: repeat(3, 105px);">
          <div class="stat-item">
            <div class="stat-label"><span>⛽ Bensin</span><span id="txt-fuel">100%</span></div>
            <div class="bar-track"><div id="bar-fuel" class="bar-fill" style="background:#fb923c"></div></div>
          </div>
          <div class="stat-item">
            <div class="stat-label"><span>🔋 Baterai</span><span id="txt-bat">100%</span></div>
            <div class="bar-track"><div id="bar-bat" class="bar-fill" style="background:#22d3ee"></div></div>
          </div>
          <div class="stat-item">
            <div class="stat-label"><span>🔧 Kondisi</span><span id="txt-van-hp">100%</span></div>
            <div class="bar-track"><div id="bar-van-hp" class="bar-fill" style="background:#4ade80"></div></div>
          </div>
        </div>
      </div>

      <!-- Controls -->
      <div class="panel controls-hint" id="controls-hint">
        <div><kbd>W A S D</kbd> Jalan / Stir • <kbd>Space</kbd> Rem Tangan / Lompat</div>
        <div><kbd>E</kbd> Keluar / Masuk Mobil • <kbd>F</kbd> Ambil / Isi / Pom Bensin</div>
        <div><kbd>L</kbd> Lampu • <kbd>H</kbd> Klakson • <kbd>C</kbd> Kamera • <kbd>Mouse Drag</kbd> Putar</div>
      </div>
    </div>
  </div>

  <!-- Interact Prompt -->
  <div id="interact-prompt" onclick="triggerInteract()">[F] Interaksi</div>

  <!-- Toast -->
  <div id="toast-container"></div>

  <!-- Mobile Touch Controls -->
  <div id="mobile-controls">
    <div class="touch-pad">
      <div></div><button class="touch-btn" onpointerdown="touchKey('KeyW',1)" onpointerup="touchKey('KeyW',0)" onpointerleave="touchKey('KeyW',0)">▲</button><div></div>
      <button class="touch-btn" onpointerdown="touchKey('KeyA',1)" onpointerup="touchKey('KeyA',0)" onpointerleave="touchKey('KeyA',0)">◀</button>
      <button class="touch-btn" onpointerdown="touchKey('KeyS',1)" onpointerup="touchKey('KeyS',0)" onpointerleave="touchKey('KeyS',0)">▼</button>
      <button class="touch-btn" onpointerdown="touchKey('KeyD',1)" onpointerup="touchKey('KeyD',0)" onpointerleave="touchKey('KeyD',0)">▶</button>
    </div>
    <div style="display:flex; flex-direction:column; gap:8px; pointer-events:auto;">
      <button class="btn primary" onclick="toggleVehicleMode()">🚗 Masuk/Keluar</button>
      <button class="btn success" onclick="triggerInteract()">✋ Interaksi</button>
    </div>
  </div>

  <!-- Modal: Inventory, Fridge & Stove -->
  <div class="modal-backdrop" id="modal-inventory">
    <div class="modal-box">
      <div class="modal-header">
        <h2>🎒 Tas Ransel, 🧊 Kulkas Mobil & 🍳 Kompor Camper</h2>
        <button class="btn" onclick="closeAllModals()">✖ Tutup (Esc)</button>
      </div>
      <div class="modal-body">
        <div class="inv-layout">
          <!-- Backpack -->
          <div class="col-box">
            <div class="col-title">
              <span>🎒 Tas Ransel</span>
              <span id="inv-count" style="font-size:12px; color:var(--muted)">0 / 20</span>
            </div>
            <div class="item-list" id="backpack-list"></div>
          </div>

          <!-- Fridge -->
          <div class="col-box">
            <div class="col-title">
              <span>🧊 Kulkas Mobil</span>
              <div style="display:flex; gap:6px; align-items:center;">
                <span id="fridge-temp-badge" style="font-size:11px; color:var(--info)">4°C ❄️</span>
                <button class="btn btn-xs" id="btn-fridge-toggle" onclick="toggleFridgePower()">ON</button>
              </div>
            </div>
            <div style="display:flex; justify-content:space-between; font-size:11px; color:var(--muted);">
              <span id="fridge-slots">Slot: 0 / 8</span>
              <span>Pendingin awetkan makanan 6x</span>
            </div>
            <div class="item-list" id="fridge-list"></div>
          </div>

          <!-- Stove & Crafting -->
          <div class="col-box">
            <div class="col-title">
              <span>🍳 Kompor & Bengkel Mini</span>
              <span style="font-size:11px; color:var(--accent)">Masak & Rakit</span>
            </div>
            <div class="item-list" id="recipe-list"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: Customize Van -->
  <div class="modal-backdrop" id="modal-customize">
    <div class="modal-box">
      <div class="modal-header">
        <h2>🎨 Hias & Upgrade Camper Van</h2>
        <button class="btn" onclick="closeAllModals()">✖ Selesai</button>
      </div>
      <div class="modal-body">
        <div style="font-size:12px; color:var(--muted); margin-bottom:8px;">
          Geser layar di sebelah kiri untuk memutar kamera melihat camper van-mu!
        </div>

        <div class="section-label">Warna Utama Bodi</div>
        <div class="color-row" id="primary-colors"></div>

        <div class="section-label">Warna Atap / Aksen</div>
        <div class="color-row" id="accent-colors"></div>

        <div class="section-label">Corak / Stiker Mobil</div>
        <div class="color-row" id="livery-buttons"></div>

        <div class="section-label">Aksesori & Dekorasi Camper</div>
        <div class="decor-grid" id="decor-list"></div>

        <div class="section-label">Upgrade Sistem Mobil</div>
        <div class="decor-grid" id="upgrade-list"></div>
      </div>
    </div>
  </div>

  <!-- Modal: Map -->
  <div class="modal-backdrop" id="modal-map">
    <div class="modal-box" style="width:min(560px, 95vw)">
      <div class="modal-header">
        <h2>🗺️ Peta Bioma Sekitar</h2>
        <button class="btn" onclick="closeAllModals()">✖ Tutup</button>
      </div>
      <div class="modal-body" style="text-align:center;">
        <canvas id="map-canvas" width="320" height="320"></canvas>
        <div class="map-legend">
          <span><span class="legend-dot" style="background:#3d4148"></span>Jalan Raya</span>
          <span><span class="legend-dot" style="background:#3c8d40"></span>Hutan</span>
          <span><span class="legend-dot" style="background:#e4be6d"></span>Gurun</span>
          <span><span class="legend-dot" style="background:#f1d99a"></span>Pantai</span>
          <span><span class="legend-dot" style="background:#8b95a5"></span>Gunung</span>
          <span><span class="legend-dot" style="background:#a16207"></span>Desa</span>
          <span><span class="legend-dot" style="background:#64748b"></span>Kota / Pom</span>
          <span><span class="legend-dot" style="background:#ef4444; border-radius:50%"></span>Kamu & Van</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Game Over -->
  <div id="gameover-screen">
    <h1 style="font-size:36px; margin:0; color:#ef4444;">💀 Perjalanan Berakhir</h1>
    <p id="gameover-reason" style="color:#cbd5e1; max-width:420px;">Kamu kehabisan tenaga di alam liar.</p>
    <p id="gameover-stats" style="color:#fbbf24; font-weight:600;"></p>
    <div style="display:flex; gap:10px;">
      <button class="btn primary" onclick="respawnAtVan()">🚑 Bangkit di Camper Van (Pertahankan Mobil)</button>
      <button class="btn danger" onclick="resetWorldNow()">🔄 Mulai Dunia Baru</button>
    </div>
  </div>

  <script>
  // =========================================================================
  // 1. ITEM DATABASE, RECIPES & CUSTOMIZATION CATALOG
  // =========================================================================
  const ITEMS = {
    berry:        { name: 'Beri Hutan', icon: '🫐', type: 'food', hunger: 12, thirst: 6, hp: 2, perishable: true, decayRate: 1.3, desc: 'Segar dari semak hutan.' },
    mushroom:     { name: 'Jamur Liar', icon: '🍄', type: 'food', hunger: 14, thirst: 0, hp: 0, perishable: true, decayRate: 1.2, desc: 'Bisa dimakan atau dimasak jadi sup.' },
    raw_meat:     { name: 'Daging Mentah', icon: '🥩', type: 'food', hunger: 10, thirst: 0, hp: -8, perishable: true, decayRate: 2.0, desc: 'Masak dulu di kompor agar sehat!' },
    raw_fish:     { name: 'Ikan Segar', icon: '🐟', type: 'food', hunger: 10, thirst: 0, hp: -4, perishable: true, decayRate: 2.1, desc: 'Didapat dari pantai. Enak dibakar!' },
    canned_food:  { name: 'Makanan Kaleng', icon: '🥫', type: 'food', hunger: 38, thirst: 5, hp: 5, perishable: false, desc: 'Awet sangat lama, temuan dari kota.' },
    bread:        { name: 'Roti Hangat', icon: '🥖', type: 'food', hunger: 26, thirst: 0, hp: 4, perishable: true, decayRate: 0.9, desc: 'Bekal nyaman di perjalanan.' },
    steak:        { name: 'Steak Panggang', icon: '🍖', type: 'food', hunger: 58, thirst: 0, hp: 18, perishable: true, decayRate: 0.85, desc: 'Hasil masakan penuh energi!' },
